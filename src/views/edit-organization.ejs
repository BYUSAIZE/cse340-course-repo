<%- include('partials/header', { title }) %>

<div class="content-container">
    <h1>Edit Organization</h1>

    <% if (errors.length > 0) { %>
        <ul class="form-errors" role="alert">
            <% errors.forEach(error => { %>
                <li><%= error.msg %></li>
            <% }) %>
        </ul>
    <% } %>

    <form action="/edit-organization/<%= organization.organization_id %>" method="post" class="category-form">
        <label for="name">Organization Name</label>
        <input
            type="text"
            id="name"
            name="name"
            value="<%= organization.name %>"
            required
            maxlength="150"
        >

        <label for="description">Description</label>
        <textarea
            id="description"
            name="description"
            rows="4"
            required
            maxlength="500"
        ><%= organization.description %></textarea>

        <label for="contactEmail">Contact Email</label>
        <input
            type="email"
            id="contactEmail"
            name="contactEmail"
            value="<%= organization.contact_email %>"
            required
            maxlength="255"
        >

        <label for="logoFilename">Logo</label>
        <select id="logoFilename" name="logoFilename" required>
            <% logos.forEach(logo => { %>
                <option
                    value="<%= logo %>"
                    <%= organization.logo_filename === logo ? 'selected' : '' %>
                >
                    <%= logo %>
                </option>
            <% }) %>
        </select>

        <img
            class="org-logo"
            src="/images/<%= organization.logo_filename %>"
            alt="Current logo for <%= organization.name %>"
        >

        <button type="submit">Save Changes</button>
        <a href="/organizations">Cancel</a>
    </form>
</div>

<%- include('partials/footer') %>