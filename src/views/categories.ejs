<%- include('partials/header', { title }) %>

<main class="container">
    <h1>Service Project Categories</h1>

    <p>Explore our service project categories.</p>

    <p><a href="/new-category">Add New Category</a></p>

    <ul>
        <% categories.forEach(category => { %>
            <li>
                <a href="/category/<%= category.category_id %>">
                    <%= category.name %>
                </a>
                (<a href="/edit-category/<%= category.category_id %>">Edit</a>)
            </li>
        <% }) %>
    </ul>
</main>

<%- include('partials/footer') %>